# Runtime data (per-deployment state, not source; lives in Docker volume on prod)
backend/data/*.json
backend/data/*.json.pre-pg7
backend/data/*.db
backend/data/*.sqlite*

# GSD tooling infrastructure (managed by npm; not project code)
.claude/.gsd-profile
.claude/gsd-core/
.claude/gsd-install-state.json
.claude/gsd-file-manifest.json
.claude/worktrees/
.claude/package.json
.claude/package-lock.json
.claude/node_modules/
.claude/scripts/
.claude/hooks/
frontend/node_modules/
frontend/dist/
frontend/tsconfig.*.tsbuildinfo
