# Where the backend lives.
#   Production (mini PC → real VPS):
#     VPS_INGEST_URL=https://your-vps-domain.com
#   Local dev (backend on host Mac, scraper in Docker):
#     VPS_INGEST_URL=http://host.docker.internal:8001
VPS_INGEST_URL=http://host.docker.internal:8001

# Shared secret with the backend .env. Any string, both sides must match.
INGEST_TOKEN=your-shared-secret-here

# kv.ee search URL to poll.
KV_SEARCH_URL=https://www.kv.ee/search?...

# Auto-scrape cadence (hours).
CHECK_INTERVAL_HOURS=2

# Local web UI port with the "Scrape now" button.
# Reachable from any home LAN device at http://<mini-pc-lan-ip>:8002.
SCRAPER_UI_PORT=8002

# Cap on listings per scrape run (0 = unlimited). Handy for local testing so
# you don't hit kv.ee with 30+ page fetches when you just want to try one.
# The UI has a per-run override input that takes precedence.
SCRAPER_MAX_LISTINGS=0
