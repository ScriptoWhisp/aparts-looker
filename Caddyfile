# Replace with your actual domain (must point to this server's IP via an A record).
# If you don't have a domain, see the README for an IP-only alternative.
:80 {
	# Machine-to-machine endpoints: authenticated by Bearer token at the FastAPI layer.
	# Caddy must not apply basicauth here — the mini PC sends Authorization: Bearer <INGEST_TOKEN>,
	# not HTTP Basic credentials. (RESEARCH Pitfall 1)
	@machine path /api/ingest /api/heartbeat
	handle @machine {
		reverse_proxy app:8000
	}

	# All other routes (dossier frontend + remaining /api/* endpoints) require basic auth.
	handle {
		basicauth {
			daniel $2a$14$I0kSivoGjrJLmTRJMSCocunDP/DT.zTN91mt58vi1.sUrA/BYklFi
		}
		reverse_proxy app:8000
	}
}
